# beads — internal state; issues.jsonl is the tracked source of truth
.beads/*
!.beads/config.yaml
!.beads/issues.jsonl
.beads.gate.lock

# Rust build output (workspace root)
/target/

# mdBook build output
/book/

# docs generated from Cargo.toml by CI — never committed
docs/src/release.md
# spec pages copied into the book by docs.yml — never committed
docs/src/specs/

# testaruda local calibration store
.testaruda/

# local-only agent tool dirs written by bd init (not tracked in the family)
.cursor/
.codex/
.agents/

# pretender runtime cache
.pretender/

# turu (whisper) local knowledge store
.whisper/

# tool report output
*.report.html

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*

# dulce-de-leche — data files (do not commit)
.ddl/**/*.db
.ddl/**/store/
.ddl/install-log.json
.ddl/doctor-cache.json
.ddl/compatibility-cache.json

# kaya — machine-local build state and capture lock (ledger + seeds are committed)
.kaya/build-state.json
.kaya/capture.lock
